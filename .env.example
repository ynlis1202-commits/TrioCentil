# ==========================================
# WARUNG MAKAN TRIOCENTIL - ENVIRONMENT VARS
# ==========================================

# TiDB Cloud Serverless Connection String (MySQL-compatible, WAJIB pakai TLS/SSL)
# Format dari TiDB Cloud Console -> Connect -> Prisma:
DATABASE_URL="mysql://<USERNAME>:<PASSWORD>@gateway01.<region>.prod.aws.tidbcloud.com:4000/warung_triocentil?sslaccept=strict"

# Session Cookie Signing Secret (wajib minimal 32 karakter acak di production)
SESSION_SECRET="ganti-dengan-secret-acak-minimal-32-karakter-di-production"

# Nomor WhatsApp Toko (format internasional tanpa tanda +, contoh: 6281234567890)
STORE_WHATSAPP_NUMBER="6281234567890"

# Konfigurasi Aplikasi Publik
NUXT_PUBLIC_APP_NAME="Warung Makan TrioCentil"
NUXT_PUBLIC_APP_URL="http://localhost:3000"

# Konfigurasi Payment Gateway QRIS (Opsional)
QRIS_ENABLED="true"
QRIS_MERCHANT_NAME="WARUNG MAKAN TRIOCENTIL"
QRIS_STATIC_PAYLOAD=""
